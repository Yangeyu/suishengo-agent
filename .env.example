NODE_ENV=development
HOST=127.0.0.1
PORT=4400
DATABASE_URL=postgresql://suishengo:local-development@127.0.0.1:5438/suishengo_agent
AUTH_ISSUER=suishengo-local
AUTH_AUDIENCE=suishengo-agent
AUTH_SECRET=local-development-only-change-before-production
# Production uses JWKS and rejects AUTH_SECRET.
AUTH_JWKS_URL=
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=
# 按实际模型配置窗口；上下文估算采用保守 UTF-8 字节数，不是服务商 tokenizer。
MODEL_CONTEXT_WINDOW=128000
MODEL_OUTPUT_TOKENS=2048
CONTEXT_COMPACTION=true
CONTEXT_TRIGGER_FRACTION=0.7
CONTEXT_KEEP_RECENT_TURNS=2
CONTEXT_SUMMARY_TOKENS=1024
MAX_CONCURRENT_RUNS=8
MAX_USER_RUNS=2
RUN_TIMEOUT_MS=120000
# Optional; SDK v6 requires a compatible Langfuse v4 instance.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROMPT_NAME=
LANGFUSE_PROMPT_VERSION=

# Agent budgets; token usage depends on provider reporting.
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOKENS=32000
LOG_LEVEL=info

# Optional MCP: fill all fields together; allow only reviewed read-only tools.
# x-agent-actor is a project-specific signed identity contract, not MCP OAuth.
MCP_URL=
MCP_ALLOWED_TOOLS=
MCP_SERVICE_TOKEN=
MCP_ACTOR_SECRET=
MCP_AUDIENCE=
