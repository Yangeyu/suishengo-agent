# 部署参数与凭据；执行策略见 apps/backend/config.yaml。
DATABASE_URL=postgresql://suishengo:local-development@127.0.0.1:5438/suishengo_agent
AUTH_SECRET=local-development-only-change-before-production

# 工作台调用 AI 服务的访问令牌，由身份签发方提供；不是 AUTH_SECRET。
AGENT_ACCESS_TOKEN=

# DashScope：默认与 agent-harness 相同的 deepseek-v4.1-flash。
DASHSCOPE_API_KEY=
# 可选：覆盖默认北京接口；地址与 Key 需匹配地域和计费方案。
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：接入已有 Langfuse，启用时填写完整三项。
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
