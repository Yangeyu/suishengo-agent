BACKEND_IMAGE=suishengo-agent:0.1.0
DATABASE_URL=postgresql://USER:PASSWORD@EXTERNAL_PG:5432/suishengo_agent

# 当前 HTTP 认证契约；与业务身份系统的实际接入仍需联调。
AUTH_ISSUER=replace-with-business-identity-issuer
AUTH_AUDIENCE=suishengo-agent
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# 默认 DashScope 北京接口及 deepseek-v4.1-flash。
DASHSCOPE_API_KEY=
# 可选：覆盖默认北京接口；地址与 Key 需匹配地域和计费方案。
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 接入已有 Langfuse；启用时填写完整三项。
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
