BACKEND_IMAGE=suishengo-agent:0.1.0
HTTP_PORT=4400
DATABASE_URL=postgresql://USER:PASSWORD@EXTERNAL_PG:5432/suishengo_agent
AUTH_ISSUER=replace-with-business-identity-issuer
AUTH_AUDIENCE=suishengo-agent
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
MODEL_BASE_URL=https://model.example.com/v1
MODEL_ID=replace-with-model-id
MODEL_API_KEY=
MAX_CONCURRENT_RUNS=8
MAX_USER_RUNS=2
RUN_TIMEOUT_MS=120000
# Existing external Langfuse service. Fill all three fields together.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional pinned text prompt version; otherwise use the checked-in system prompt.
LANGFUSE_PROMPT_NAME=
LANGFUSE_PROMPT_VERSION=
