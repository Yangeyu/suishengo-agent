{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@harness": ["./packages/harness/src/index.ts"],
      "@runtime": ["./packages/runtime/src/index.ts"],
      "@runtime/*": ["./packages/runtime/src/*"],
      "@plugins/*": ["./plugins/*"],
      "@backend/*": ["./apps/backend/src/*"],
      "@harness/*": ["./packages/harness/src/*"],
      "@flow": ["./packages/flow/src/index.ts"],
      "@flow/*": ["./packages/flow/src/*"],
      "@logging": ["./packages/logging/src/index.ts"],
      "@backend-tests/*": ["./apps/backend/__tests__/*"]
    }
  },
  "include": [
    "apps/backend/**/*.ts",
    "apps/eval/**/*.ts",
    "packages/**/*.ts",
    "plugins/**/*.ts",
    "scripts/**/*.ts"
  ]
}
